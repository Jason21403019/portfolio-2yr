---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
import { CATS } from '../data/cats';

const total = projects.reduce((a, p) => a + p.commits, 0);
const astroN = projects.filter((p) => p.tech.includes('Astro')).length;
const nuxtN = projects.filter((p) => p.tech.includes('Nuxt 3')).length;

const years = [...new Set(projects.map((p) => p.s.slice(0, 4)))].sort().reverse();
const byYear = years.map((y) => ({
  year: y,
  items: projects.filter((p) => p.s.startsWith(y)).sort((a, b) => b.s.localeCompare(a.s)),
}));
const filters = [
  { k: 'all', label: '全部', n: projects.length },
  ...Object.entries(CATS).map(([k, v]) => ({ k, label: v[0], n: projects.filter((p) => p.cat === k).length })),
];
---

<Base title="作品" description="兩年做過的互動活動、專題頁與行銷頁。" current="works">
  <header class="works-head">
    <h1>兩年，<br /><em data-count={projects.length}>{projects.length}</em> 個頁面</h1>
    <div class="facts">
      <b>2024.09 – 2026.10</b><br />
      <b data-count={total}>{total.toLocaleString()}</b> 次 commit<br />
      Astro <b>{astroN}</b> · Nuxt <b>{nuxtN}</b>
    </div>
  </header>

  <div class="bar" id="bar">
    {filters.map((f) => (
      <button type="button" data-k={f.k} aria-pressed={f.k === 'all'}>
        {f.label}<span class="n">{f.n}</span>
      </button>
    ))}
  </div>

  <div>
    {byYear.map((g) => (
      <section class="year" data-year={g.year}>
        <div class="yr">{g.year}<small><span class="cnt">{g.items.length}</span> 個</small></div>
        <div class="wall">
          {g.items.map((p) => <ProjectCard p={p} />)}
        </div>
      </section>
    ))}
  </div>

  <script>
      const bar = document.getElementById('bar')!;
      bar.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('button');
        if (!b) return;
        const k = b.dataset.k!;
        bar.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        document.querySelectorAll<HTMLElement>('.card').forEach((c) => {
          c.hidden = k !== 'all' && c.dataset.cat !== k;
        });
        document.querySelectorAll<HTMLElement>('.year').forEach((s) => {
          const n = s.querySelectorAll('.card:not([hidden])').length;
          s.hidden = n === 0;
          s.querySelector('.cnt')!.textContent = String(n);
        });
      });
    </script>
</Base>
